# Secrets
.env

# Local runtime data: database, captured evidence, footage
data/

# Generated media is ignored by default; the committed fixtures and the
# documentation screenshots are the deliberate exceptions.
*.mp4
*.jpg
*.jpeg
!fixtures/*.mp4
!docs/**/*.jpg
!docs/**/*.png

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node
node_modules/
# frontend/dist is committed deliberately so the app runs with Python alone.
# Rebuild with: cd frontend && npm run build

# TypeScript incremental build artifact
*.tsbuildinfo

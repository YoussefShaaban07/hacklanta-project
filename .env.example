# Copy to .env and fill in. .env is gitignored; never commit a real key.

# --- Vision provider -------------------------------------------------------
# Get a key at https://aistudio.google.com
# Leave blank to run the offline heuristic provider (see README). The app
# reports which one is in use and the UI shows a banner when it is not real.
GEMINI_API_KEY=
# Pin the exact model id you calibrated against, and do not change it after
# calibration -- thresholds tuned on one model do not transfer to another.
VISION_MODEL=gemini-2.0-flash
# auto | gemini | heuristic.  auto picks gemini when a key is present.
VISION_PROVIDER=auto

# --- Camera ----------------------------------------------------------------
# usb | file | synthetic | rtsp
#   usb       - a real webcam on the demo laptop (CAMERA_INDEX)
#   file      - replay a recording (CAMERA_FILE_PATH), e.g. fixtures/demo_tray.mp4
#   synthetic - generated scene, no camera needed; used by CI and the demo
CAMERA_SOURCE_KIND=synthetic
CAMERA_INDEX=0
CAMERA_FILE_PATH=fixtures/demo_tray.mp4
# How often a frame is analysed. Preview runs faster; they are separate.
SAMPLE_INTERVAL_SECONDS=2
PREVIEW_FPS=10
# A frame older than this marks the camera stale.
STALE_AFTER_SECONDS=6

# --- Storage ---------------------------------------------------------------
# Defaults are absolute paths under the repo's data/ directory.
# DATABASE_PATH=data/camera_agent.db
# EVIDENCE_DIR=data/evidence
EVIDENCE_CAP_MB=2048

# --- Webhook allowlist -----------------------------------------------------
# The compiler picks a destination *id*; URLs are resolved here, never from
# model output. Format: id|url  (comma-separated for several destinations)
WEBHOOK_DESTINATIONS=test_receiver|http://127.0.0.1:9000/hook
WEBHOOK_TIMEOUT_SECONDS=5
